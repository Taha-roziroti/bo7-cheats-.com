---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLanding from '../components/HomeLanding.astro';
import { loadContentPage } from '../utils/loadContentPage';
import { jsonLdForContentPage } from '../utils/contentPageJsonLd';
import { MAIN_PRODUCT_CHECKOUT } from '../data/productCatalog';
import { PRODUCT_ID } from '../data/site';
import { productSchema } from '../utils/schema';
import { HERO_SECTION_LCP_PRELOAD } from '../data/showcaseImages';
import { PLACEHOLDER_COPY } from '../data/placeholders';
import { PRIMARY_SHOWCASE_IMAGE } from '../data/showcaseImages';

const homeEntry = await loadContentPage('index');
const home = homeEntry.data as { title: string; description: string; slug: string };

const jsonLd = [
  productSchema({
    name: PLACEHOLDER_COPY.productName,
    description: home.description,
    url: '/',
    offerUrl: MAIN_PRODUCT_CHECKOUT,
    sku: 'main-product-placeholder',
    image: PRIMARY_SHOWCASE_IMAGE,
    productId: PRODUCT_ID,
    offers: [
      { name: `${PLACEHOLDER_COPY.productName} — Monthly`, priceUsd: 35, url: MAIN_PRODUCT_CHECKOUT },
      { name: `${PLACEHOLDER_COPY.productName} — Lifetime`, priceUsd: 150, url: MAIN_PRODUCT_CHECKOUT },
    ],
  }),
  ...jsonLdForContentPage({
    route: '/',
    seoTitle: home.title,
    metaDescription: home.description,
    schemaTypes: ['BreadcrumbList'],
  }),
];
---

<BaseLayout
  title={home.title}
  description={home.description}
  jsonLd={jsonLd}
  ogImage="/og/home.jpg"
  ogImageAlt="Black Ops 7 Cheats for PC"
  logoAlt={`${PLACEHOLDER_COPY.siteName} – logo`}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={HERO_SECTION_LCP_PRELOAD}
    type="image/webp"
    fetchpriority="high"
  />
  <HomeLanding />
</BaseLayout>
