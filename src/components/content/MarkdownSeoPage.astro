---
import '../../styles/content-markdown.css';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CheckoutDirectPanel from '../checkout/CheckoutDirectPanel.astro';
import type { CheckoutProductId } from '../checkout/CheckoutProductPicker.astro';
import AdditionalCostsCallout from '../checkout/AdditionalCostsCallout.astro';
import { loadContentPage } from '../../utils/loadContentPage';
import { injectAffiliateLinks, checkoutProductForSlug } from '../../utils/affiliateLinks';
import { breadcrumbSchema, faqPageSchemaFromPairs, webPageSchema } from '../../utils/schema';
import { SITE_NAME, ogImageForPath } from '../../data/site';
import { faqItemsFromMarkdown } from '../../utils/markdownFaq';
import { productJsonLdForRoute } from '../../utils/productPageJsonLd';
import ContentFigures from './ContentFigures.astro';
import { PAGE_SHOWCASE_SHOTS } from '../../data/showcaseImages';

interface Props {
  id: string;
  breadcrumbs: { name: string; path: string }[];
  checkoutProduct?: CheckoutProductId;
  showAdditionalCosts?: boolean;
  noindex?: boolean;
  useProductShell?: boolean;
}

const {
  id,
  breadcrumbs,
  checkoutProduct: checkoutProductProp,
  showAdditionalCosts = false,
  noindex = false,
  useProductShell = true,
} = Astro.props;

const entry = await loadContentPage(id);
const data = entry.data as { title: string; description: string; slug: string };

if (!('slug' in data) || !('title' in data) || !('description' in data)) {
  throw new Error(`MarkdownSeoPage requires content frontmatter (title, description, slug): ${id}`);
}

const slug = data.slug.endsWith('/') || data.slug === '/' ? data.slug : `${data.slug}/`;
const checkoutProduct: CheckoutProductId =
  checkoutProductProp ??
  (checkoutProductForSlug(slug) === 'cloudDma'
    ? 'cloud-dma'
    : checkoutProductForSlug(slug) === 'hwidSpoofer'
      ? 'hwid-spoofer'
      : 'main-product');

const patchedEntry = {
  ...entry,
  body: injectAffiliateLinks(entry.body, slug),
};

const { Content } = await render(patchedEntry);

const pageFaqs = faqItemsFromMarkdown(entry.body);
const productName = data.title.replace(/\s*\|.*$/, '').trim();
const productLd = productJsonLdForRoute(slug, productName, data.description, checkoutProduct);
const jsonLd = [
  webPageSchema({ name: data.title, description: data.description, url: slug }),
  breadcrumbSchema(breadcrumbs),
  ...(productLd ? [productLd] : []),
  ...(pageFaqs.length >= 2 ? [faqPageSchemaFromPairs(pageFaqs)] : []),
];
const routeOg = ogImageForPath(slug);
const showcaseFigures = (PAGE_SHOWCASE_SHOTS[slug] ?? []).map((shot) => ({
  src: shot.src,
  alt: shot.alt,
}));
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogImage={routeOg}
  ogImageAlt={data.title}
  noindex={noindex}
  jsonLd={jsonLd}
  logoAlt={`${data.title} – ${SITE_NAME}`}
>
  {
    useProductShell ? (
      <section class="border-b border-border bg-muted/20 py-10 md:py-14">
        <div class="mx-auto max-w-6xl px-5">
          <Breadcrumbs items={breadcrumbs} class="mb-6 md:mb-8" />
        </div>
        <div class="mx-auto grid max-w-6xl items-start gap-10 px-5 lg:grid-cols-[1fr_minmax(18rem,22rem)]">
          <article class="content-markdown min-w-0 max-w-3xl">
            {
              showcaseFigures.length > 0 ? (
                <section class="not-prose mb-8" data-reveal="up">
                  <h2 class="mb-4 font-[family-name:var(--font-heading)] text-xl font-semibold text-foreground">
                    Visual examples
                  </h2>
                  <div data-reveal="scale" data-lenis-prevent>
                    <ContentFigures figures={showcaseFigures} />
                  </div>
                </section>
              ) : null
            }
            <Content />
            {showAdditionalCosts ? (
              <AdditionalCostsCallout class="not-prose mt-8" pagePath={slug} />
            ) : null}
            <div class="not-prose mt-8 lg:hidden">
              <CheckoutDirectPanel product={checkoutProduct} />
            </div>
          </article>
          <div class="hidden lg:block" data-reveal="right">
            <CheckoutDirectPanel product={checkoutProduct} />
          </div>
        </div>
      </section>
    ) : (
      <article class="border-b border-border bg-muted/20 py-10 md:py-14">
        <div class="mx-auto max-w-6xl px-5">
          <Breadcrumbs items={breadcrumbs} class="mb-6 md:mb-8" />
          <div class="content-markdown mt-2 max-w-3xl">
            <Content />
          </div>
        </div>
      </article>
    )
  }
</BaseLayout>
