---
interface Props {
  class?: string;
  /** Omit redundant in-page links when already on the Cloud DMA route. */
  pagePath?: string;
}

const { class: className = '', pagePath = '' } = Astro.props;
const onCloudDma = pagePath === '/cloud-dma/' || pagePath === '/cloud-dma';
---

<aside
  class={`rounded-2xl border border-amber-500/40 bg-amber-500/10 p-5 text-sm text-foreground ${className}`}
  aria-labelledby="cloud-dma-additional-costs"
>
  <h2 id="cloud-dma-additional-costs" class="text-base font-semibold text-foreground">
    Cloud DMA license is not the full setup cost
  </h2>
  <p class="mt-2 text-muted-foreground">
    The listed Cloud DMA price covers the infrastructure license only. You must also purchase and maintain these
    separate services before activation:
  </p>
  <ul class="mt-3 list-disc space-y-2 pl-5 text-muted-foreground">
    <li>
      <strong class="text-foreground">GREENWARD</strong> — required activation and routing service (bought outside this
      site).
    </li>
    <li>
      <strong class="text-foreground">Static Server</strong> — dedicated server component with its own fee.
    </li>
    <li>
      <strong class="text-foreground">AWS</strong> — cloud resources with separate billing; not included in the $50 license.
    </li>
  </ul>
  <p class="mt-3 text-muted-foreground">
    Budget for all three in addition to the license before you reach checkout.
    {
      onCloudDma ? (
        <>
          {' '}
          Review the <a class="text-primary underline-offset-2 hover:underline" href="#cloud-dma-pricing">pricing section above</a>
          {' '}
          and the
          <a class="text-primary underline-offset-2 hover:underline" href="/guides/bo7-cheat-requirements/"> Windows and virtualization checklist</a>
          {' '}
          when you plan checkout.
        </>
      ) : (
        <>
          {' '}
          See the
          <a class="text-primary underline-offset-2 hover:underline" href="/cloud-dma/"> Cloud DMA licensing details</a> and the
          <a class="text-primary underline-offset-2 hover:underline" href="/guides/bo7-cheat-requirements/"> Windows and virtualization checklist</a> for context.
        </>
      )
    }
  </p>
</aside>
