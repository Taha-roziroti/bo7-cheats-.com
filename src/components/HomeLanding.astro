---
import HeroSection from './HeroSection.astro';
import FeaturesSection from './FeaturesSection.astro';
import ProductsSection from './ProductsSection.astro';
import WhySetupSection from './WhySetupSection.astro';
import WorkflowSection from './WorkflowSection.astro';
import HomeGuidesSection from './HomeGuidesSection.astro';
import HomeMarkdownContent from './HomeMarkdownContent.astro';
import ProductScreenshotGallery from './ProductScreenshotGallery.astro';
import { PRODUCT_PREVIEW_GALLERY } from '../data/media';
---

<HeroSection />
<FeaturesSection />
<section class="border-y border-border bg-background py-12 md:py-16" aria-label="In-game screenshot gallery">
  <div class="mx-auto max-w-6xl px-5">
    <p
      id="showcase-gallery-title"
      class="mb-6 font-[family-name:var(--font-heading)] text-2xl font-bold text-foreground md:text-3xl"
      data-reveal="up"
    >
      Black Ops 7 — in-game previews
    </p>
    <div data-reveal="scale" data-lenis-prevent>
      <ProductScreenshotGallery images={PRODUCT_PREVIEW_GALLERY} id="home-showcase-gallery" />
    </div>
  </div>
</section>
<ProductsSection />
<WhySetupSection />
<WorkflowSection />
<HomeGuidesSection />
<HomeMarkdownContent />
