---
import '../styles/content-markdown.css';
import { render } from 'astro:content';
import { loadContentPage } from '../utils/loadContentPage';
import { injectAffiliateLinks } from '../utils/affiliateLinks';

const entry = await loadContentPage('index');
const data = entry.data as { slug: string };
const slug = data.slug.endsWith('/') ? data.slug : `${data.slug}/`;
const patchedEntry = {
  ...entry,
  body: injectAffiliateLinks(entry.body, slug),
};
const { Content } = await render(patchedEntry);
---

<section class="border-t border-border bg-background py-12 md:py-16" id="abi-overview" data-reveal="up">
  <div class="content-markdown mx-auto max-w-3xl px-5">
    <Content />
  </div>
</section>
