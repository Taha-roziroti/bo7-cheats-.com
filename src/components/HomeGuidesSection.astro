---
import { guideCards } from '../data/landingData';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
---

<section id="guides" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="guides-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow="Guides"
      title="Cloud DMA, HWID, and PC requirements"
      desc="Use these supporting pages before checkout—each targets a different search intent without duplicate feature landings."
      titleId="guides-title"
      titleAs="h2"
      motionReveal="up"
    />

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-10" data-reveal-stagger>
      {
        guideCards.map((guide) => (
          <article class="flex h-full flex-col rounded-2xl border border-border bg-card p-6 shadow-sm transition-[transform,border-color] duration-300 hover:-translate-y-0.5 hover:border-primary/35">
            <p class="m-0 font-[family-name:var(--font-heading)] text-lg font-bold leading-snug text-foreground">
              {guide.title}
            </p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">{guide.desc}</p>
            <Button as="a" href={guide.href} variant="outline" size="sm" class="mt-6 w-fit rounded-lg">
              {guide.readLabel}
              <Icon name="arrowRight" size={16} />
            </Button>
          </article>
        ))
      }
    </div>
  </div>
</section>
